    "migration",
    "converter",
    "cli"
  ],
  "homepage": "https://github.com/dizitart/bcup2kdbx#readme",
  "bugs": {
    "url": "https://github.com/dizitart/bcup2kdbx/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dizitart/bcup2kdbx.git"
  },
  "license": "Apache-2.0",
  "author": "Dizitart",
  "type": "module",
  "exports": {
    ".": "./lib.js"
  },
  "main": "./lib.js",
